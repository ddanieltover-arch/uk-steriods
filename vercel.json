{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma generate && npx vite build && npx esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=api/server.bundle.cjs",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/v1/internal/notifications/process",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/ready", "destination": "/api" },
    { "source": "/robots.txt", "destination": "/api" },
    { "source": "/sitemap.xml", "destination": "/api" },
    { "source": "/llms.txt", "destination": "/api" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{api/server.bundle.cjs,prisma/**,node_modules/.prisma/**,node_modules/@prisma/client/**,dist/index.html,dist/assets/**}"
    }
  }
}
