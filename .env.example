# ==========================================
# PUBLIC (non-secret) — safe for browser/docs
# ==========================================
# Classification: PUBLIC | OPTIONAL (aliases accepted)
# Used for SEO, absolute links, and email deep links (server reads these).
SITE_URL="http://localhost:3001"
PUBLIC_SITE_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Classification: PUBLIC | REQUIRED in production
# Comma-separated browser origins for credentialed CORS.
CLIENT_ORIGIN="http://localhost:5173,http://localhost:3001"

# Optional Vite-exposed DEMO bank labels only (never real credentials).
# Prefer server BANK_* variables for payment instructions.
# Classification: PUBLIC | OPTIONAL | DEVELOPMENT_ONLY recommended
# VITE_BANK_BENEFICIARY_NAME="DEMO MERCHANTS LTD"
# VITE_BANK_NAME="UK Commercial Bank PLC"
# VITE_BANK_SORT_CODE="00-00-00"
# VITE_BANK_ACCOUNT_NUMBER="00000000"

# ==========================================
# SERVER_ONLY — never prefix with VITE_
# ==========================================

# Classification: SERVER_ONLY | REQUIRED
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uk_ecommerce?schema=public"

# Classification: SERVER_ONLY | REQUIRED in production (min 16 chars) | OPTIONAL in development
AUTH_SECRET="your-super-secret-auth-key-change-in-production"

# Classification: SERVER_ONLY | OPTIONAL (defaults true when NODE_ENV=production)
# COOKIE_SECURE="true"

# Classification: SERVER_ONLY | REQUIRED for process (default development)
NODE_ENV="development"
# Classification: SERVER_ONLY | OPTIONAL (default 3001)
PORT="3001"

# Transactional email
# Classification: SERVER_ONLY | OPTIONAL (default: dev)
EMAIL_PROVIDER="dev"
# Classification: SERVER_ONLY | OPTIONAL
EMAIL_FROM_ADDRESS="noreply@ukperformance.local"
EMAIL_FROM_NAME="UK Performance"
EMAIL_REPLY_TO="support@ukperformance.local"
# Classification: SERVER_ONLY | REQUIRED when EMAIL_PROVIDER=resend | PRODUCTION_ONLY for live delivery
# EMAIL_API_KEY=""

# Classification: SERVER_ONLY | OPTIONAL
NOTIFICATION_POLL_MS="5000"

# Classification: SERVER_ONLY | OPTIONAL | PRODUCTION_ONLY if enabling previews
# ALLOW_EMAIL_PREVIEW="false"

# Optional distributed rate limiting (not required for single-instance)
# Classification: SERVER_ONLY | OPTIONAL
# REDIS_URL="redis://localhost:6379"
# RATE_LIMIT_STORE="memory"

# Object storage — unused for URL-only product images; keep off Vite
# Classification: SERVER_ONLY | OPTIONAL
STORAGE_BUCKET="uk-ecommerce-assets"
STORAGE_ACCESS_KEY="your-storage-access-key"
STORAGE_SECRET_KEY="your-storage-secret-key"
STORAGE_REGION="eu-west-2"

# Demo bank details for PaymentService (server-side)
# Classification: SERVER_ONLY | OPTIONAL (demo values only)
BANK_BENEFICIARY_NAME="DEMO MERCHANTS LTD"
BANK_NAME="UK Commercial Bank PLC"
BANK_SORT_CODE="00-00-00"
BANK_ACCOUNT_NUMBER="00000000"
