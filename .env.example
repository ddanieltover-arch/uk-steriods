# ==========================================
# PUBLIC (non-secret) — safe for browser/docs
# ==========================================
# Classification: PUBLIC | OPTIONAL (aliases accepted)
# Used for SEO, absolute links, and email deep links (server reads these).
# Use the live canonical host (www). Apex redirects to www — mismatch breaks GSC.
SITE_URL="https://www.uk-steroids.co.uk"
PUBLIC_SITE_URL="https://www.uk-steroids.co.uk"
NEXT_PUBLIC_SITE_URL="https://www.uk-steroids.co.uk"

# Classification: PUBLIC | REQUIRED in production
# Comma-separated browser origins for credentialed CORS.
CLIENT_ORIGIN="https://uk-steroids.co.uk,https://www.uk-steroids.co.uk,http://localhost:5173,http://localhost:3001"

# Optional Vite-exposed DEMO bank labels only (never real credentials).
# Prefer server BANK_* variables for payment instructions.
# Classification: PUBLIC | OPTIONAL | DEVELOPMENT_ONLY recommended
# VITE_BANK_BENEFICIARY_NAME="DEMO MERCHANTS LTD"
# VITE_BANK_NAME="UK Commercial Bank PLC"
# VITE_BANK_SORT_CODE="00-00-00"
# VITE_BANK_ACCOUNT_NUMBER="00000000"

# ==========================================
# SERVER_ONLY — never prefix with VITE_
# ==========================================

# Classification: SERVER_ONLY | REQUIRED
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uk_ecommerce?schema=public"

# Classification: SERVER_ONLY | REQUIRED in production (min 16 chars) | OPTIONAL in development
AUTH_SECRET="your-super-secret-auth-key-change-in-production"

# Classification: SERVER_ONLY | OPTIONAL (defaults true when NODE_ENV=production)
# COOKIE_SECURE="true"

# Classification: SERVER_ONLY | REQUIRED for process (default development)
NODE_ENV="development"
# Classification: SERVER_ONLY | OPTIONAL (default 3001)
PORT="3001"

# Official operations / admin account (used by seed and ensure-admin)
# Classification: SERVER_ONLY | OPTIONAL (default sales@uk-steroids.co.uk)
ADMIN_EMAIL="sales@uk-steroids.co.uk"
# Classification: SERVER_ONLY | REQUIRED for npm run db:ensure-admin
ADMIN_BOOTSTRAP_PASSWORD="change-me-to-a-strong-password"

# Transactional email (Resend)
# Classification: SERVER_ONLY | OPTIONAL (default: dev)
EMAIL_PROVIDER="resend"
# Classification: SERVER_ONLY | OPTIONAL
EMAIL_FROM_ADDRESS="sales@uk-steroids.co.uk"
EMAIL_FROM_NAME="Steroids UK"
EMAIL_REPLY_TO="sales@uk-steroids.co.uk"
# Classification: SERVER_ONLY | REQUIRED when EMAIL_PROVIDER=resend | PRODUCTION_ONLY for live delivery
# Resend dashboard name; EMAIL_API_KEY is the app alias (either works).
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_API_KEY="re_xxxxxxxx"

# Classification: SERVER_ONLY | OPTIONAL
NOTIFICATION_POLL_MS="5000"

# Secures /api/v1/internal/notifications/process (Vercel Cron). Generate a long random string.
# Classification: SERVER_ONLY | REQUIRED on Vercel production for cron drain
# CRON_SECRET="replace-with-a-long-random-secret"

# Classification: SERVER_ONLY | OPTIONAL | PRODUCTION_ONLY if enabling previews
# ALLOW_EMAIL_PREVIEW="false"

# Optional distributed rate limiting (not required for single-instance)
# Classification: SERVER_ONLY | OPTIONAL
# REDIS_URL="redis://localhost:6379"
# RATE_LIMIT_STORE="memory"

# Object storage — unused for URL-only product images; keep off Vite
# Classification: SERVER_ONLY | OPTIONAL
STORAGE_BUCKET="uk-ecommerce-assets"
STORAGE_ACCESS_KEY="your-storage-access-key"
STORAGE_SECRET_KEY="your-storage-secret-key"
STORAGE_REGION="eu-west-2"

# Demo bank details for PaymentService (server-side)
# Classification: SERVER_ONLY | OPTIONAL (demo values only)
BANK_BENEFICIARY_NAME="DEMO MERCHANTS LTD"
BANK_NAME="UK Commercial Bank PLC"
BANK_SORT_CODE="00-00-00"
BANK_ACCOUNT_NUMBER="00000000"

# Crypto receive wallets (admin payment instructions)
# Classification: SERVER_ONLY | OPTIONAL
# Prefer secrets/crypto-wallets.env in production; do not commit live addresses.
# CRYPTO_BTC_ADDRESS=""
# CRYPTO_ETH_ADDRESS=""
# CRYPTO_BCH_ADDRESS=""

# ==========================================
# SEARCH GROWTH ENGINEERING (GSC / GA4 API)
# ==========================================
# Used by Search Growth Engineering Skill connectors only — not the web app runtime.
# Full setup: docs/search-growth-connectors.md
# Template: Search Growth Engineering Skill/workspaces/uk-steroids/connectors.example.env
# Classification: SERVER_ONLY | OPTIONAL (required for SGE sync)

# SGE_ENV_FILE="secrets/sge-connectors.env"
# GSC_SITE_URL="https://uk-steroids.co.uk/"
# GA4_PROPERTY_ID=""
# GOOGLE_APPLICATION_CREDENTIALS="secrets/google-service-account.json"

# ==========================================
# SITE ANALYTICS (browser gtag — optional)
# ==========================================
# Classification: PUBLIC | OPTIONAL
# GA4 Admin → Data streams → Measurement ID (G-XXXXXXXX). Feeds the GA4 property above.
# VITE_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
